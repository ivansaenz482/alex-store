# Copia este archivo a `.env` (junto al docker-compose.yml) y ajusta los valores.
# NUNCA subas el `.env` real a GitHub.

# Contraseña del panel admin → https://tu-dominio.com/admin
ADMIN_PASSWORD=cambia-esto-por-una-contrasena-segura
# Secreto largo y aleatorio (cualquier cadena, máx seguridad si es largo)
ADMIN_SECRET=$(openssl rand -hex 32)

# Copia este archivo a .env.local y ajusta los valores antes de publicar.
# Contraseña del panel de administración  →  http://localhost:3000/admin
ADMIN_PASSWORD=alexstore
# Secreto adicional para firmar la sesión
ADMIN_SECRET=alex-store-secret-2026

# ── Supabase (opcional, para que el admin guarde en la nube) ─────────────
# URL del proyecto  →  Settings → API → Project URL
SUPABASE_URL=
# Service Role Key (secreto, solo servidor) → Settings → API → Service Role
SUPABASE_SERVICE_ROLE_KEY=

# ── Notificaciones push (opcional) ───────────────────────────────────────
# Genera las claves con:  npx web-push generate-vapid-keys
# En VPS/local se generan solas (data/vapid.json) si no las defines aquí.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del remitente (obligatorio para navegadores)
VAPID_SUBJECT=mailto:ventas@alexstore.com
